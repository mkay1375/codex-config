# Ignore everything unless explicitly allowed below.
*

# Repository documentation and tracking rules.
!/.gitignore
!/README.md

# Tracked skills and their supporting files.
!/skills/
!/skills/frontend-design/
!/skills/frontend-design/**
!/skills/cpcb/
!/skills/cpcb/**
!/skills/cleanup/
!/skills/cleanup/**
!/skills/merge-prs/
!/skills/merge-prs/**
!/skills/rephrase/
!/skills/rephrase/**
!/skills/summarize/
!/skills/summarize/**
!/skills/e2e-worktree/
!/skills/e2e-worktree/**
!/skills/remove-python-dead-code/
!/skills/remove-python-dead-code/**
!/skills/prune/
!/skills/prune/**
!/skills/pause/
!/skills/pause/**
!/skills/readable-html/
!/skills/readable-html/**

# Synced skills stay local and are never tracked.
/skills/synced/

!AGENTS.md

# Keep generated files ignored even inside an allowed skill.
.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/

# RTK instructions are machine-local.
/[Rr][Tt][Kk].md
